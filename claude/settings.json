{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(diff:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(tr:*)",
      "Bash(column:*)",
      "Bash(paste:*)",
      "Bash(tee:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(xargs:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(hostname:*)",
      "Bash(id:*)",
      "Bash(pwd:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(jps:*)",
      "Bash(lsof:*)",
      "Bash(top:*)",
      "Bash(htop:*)",
      "Bash(git:*)",
      "Bash(glab:*)",
      "Bash(bazel:*)",
      "Bash(bazelisk:*)",
      "Bash(task:*)",
      "Bash(md5sum:*)",
      "Bash(sha256sum:*)",
      "Bash(sha1sum:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(zcat:*)",
      "Bash(./ci.sh:*)",
      "Bash(./iac/ci-cd/format.sh:*)",
      "Bash(./iac/ci-cd/lint.sh:*)",
      "Bash(./iac/ci-cd/test.sh:*)",
      "mcp__bt-tools__*"
    ],
    "deny": [],
    "ask": [
      "mcp__bt-tools__bigquery_authorize",
      "mcp__bt-tools__bigquery_disconnect",
      "mcp__bt-tools__bigquery_set_project",
      "mcp__bt-tools__credential_register",
      "mcp__bt-tools__credential_remove",
      "mcp__bt-tools__monday_add_update",
      "mcp__bt-tools__monday_create_item",
      "mcp__bt-tools__monday_update_item",
      "mcp__bt-tools__redmine_attach_file",
      "mcp__bt-tools__redmine_create_issue",
      "mcp__bt-tools__redmine_update_issue"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/claude/hooks/teams_notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/claude/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "hydra@belvedere-trading": true
  },
  "extraKnownMarketplaces": {
    "belvedere-trading": {
      "source": {
        "source": "git",
        "url": "git@gitlab.com:belvederetrading/private/claude-code.git"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "skipAutoPermissionPrompt": true
}
